# Spectra environment variables

# Base currency used for all output and budgets.
BASE_CURRENCY=VND

# Supabase/Postgres connection string. Keep the real value in .env or host secrets.
# For a long-running FastAPI server, use Supabase direct connection or Session Pooler.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Google Sheets sync is optional. Leave SPREADSHEET_ID empty to use Postgres only.
SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEETS_CREDENTIALS_B64=

# Choose openai, gemini, or local.
AI_PROVIDER=local

# Optional cloud AI providers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemma-3-27b-it

LOG_LEVEL=INFO

# Local demo login / SSO between Spectra and Bank Simulator.
SSO_SHARED_SECRET=change-me-for-local-demo
SPECTRA_BASE_URL=http://localhost:8081
BANK_SIMULATOR_BASE_URL=http://localhost:8000
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
SSO_TOKEN_TTL_SECONDS=300
DEMO_BANK_PASSWORD=Bank@123456
BANK_PASSWORD_ITERATIONS=210000
