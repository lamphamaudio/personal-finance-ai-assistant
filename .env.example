# Spectra environment variables

# Base currency used for all output and budgets.
BASE_CURRENCY=VND

# Supabase/Postgres connection string. Keep the real value in .env or host secrets.
# For a long-running FastAPI server, use Supabase direct connection or Session Pooler.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Google Sheets sync is optional. Leave SPREADSHEET_ID empty to use Postgres only.
SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEETS_CREDENTIALS_B64=

# Choose openai, gemini, or local.
AI_PROVIDER=local

# Optional cloud AI providers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemma-3-27b-it

LOG_LEVEL=INFO
