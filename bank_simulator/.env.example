# ============================================================================
# Bank Simulator Environment Variables (Example)
# ============================================================================
# Copy this file to .env and update with your actual values

# Database Configuration (Shared with main service)
DATABASE_URL=postgresql://user:password@host:port/database

# API Configuration
BANK_SIMULATOR_PORT=8000
BANK_SIMULATOR_HOST=0.0.0.0

# Frontend Configuration
BANK_SIMULATOR_FRONTEND_PORT=3000

# CORS Configuration (Allow main service to access)
CORS_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Base Currency
BASE_CURRENCY=VND
